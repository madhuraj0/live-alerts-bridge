<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="false">

    <!-- Blurred Album Art Background Image -->
    <ImageView
        android:id="@+id/imgBlurredBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Dark translucent scrim for high text contrast and ColorOS glass look -->
    <View
        android:id="@+id/scrimBlurredBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C121212" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp">

        <!-- Album Artwork Card (Left Column) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAlbumArt"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#20000000"
            app:strokeColor="#38FFFFFF"
            app:strokeWidth="1.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgAlbumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/album_artwork"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_launcher_foreground" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Right Column: Top Bar Controls -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_glass_circle_button"
            android:contentDescription="@string/settings"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            app:layout_constraintEnd_toStartOf="@id/btnClose"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_circle_button"
            android:contentDescription="@string/close"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface" />

        <!-- Track Title -->
        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            android:ellipsize="marquee"
            android:fadingEdge="horizontal"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
            app:layout_constraintTop_toBottomOf="@id/btnClose"
            tools:text="Song Title Here" />

        <!-- Track Artist -->
        <TextView
            android:id="@+id/tvTrackArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
            app:layout_constraintTop_toBottomOf="@id/tvTrackTitle"
            tools:text="Artist Name • Album Name" />

        <!-- Interactive Seek Bar (Landscape) -->
        <SeekBar
            android:id="@+id/seekBarPlayback"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:progress="0"
            android:progressBackgroundTint="#4DFFFFFF"
            android:progressTint="?attr/colorOnSurface"
            android:thumbTint="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
            app:layout_constraintTop_toBottomOf="@id/tvTrackArtist" />

        <TextView
            android:id="@+id/tvCurrentPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
            app:layout_constraintTop_toBottomOf="@id/seekBarPlayback"
            tools:text="00:00" />

        <TextView
            android:id="@+id/tvTotalDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/seekBarPlayback"
            tools:text="00:00" />

        <!-- Glassy Playback Controls Dock (Landscape) -->
        <LinearLayout
            android:id="@+id/transportControlsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
            app:layout_constraintTop_toBottomOf="@id/tvCurrentPosition">

            <!-- Left Custom Action (e.g. Shuffle) -->
            <FrameLayout
                android:id="@+id/slotCustomActionLeft"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="12dp"
                android:visibility="invisible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevious"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/previous"
                app:backgroundTint="#24808080"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_skip_previous"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface"
                app:rippleColor="#33FFFFFF"
                app:strokeColor="#38FFFFFF"
                app:strokeWidth="1.2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayPause"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="@string/play_pause"
                app:backgroundTint="#38808080"
                app:cornerRadius="27dp"
                app:icon="@drawable/ic_pause"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="28dp"
                app:iconTint="?attr/colorOnSurface"
                app:rippleColor="#40FFFFFF"
                app:strokeColor="#59FFFFFF"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/next"
                app:backgroundTint="#24808080"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_skip_next"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface"
                app:rippleColor="#33FFFFFF"
                app:strokeColor="#38FFFFFF"
                app:strokeWidth="1.2dp" />

            <!-- Right Custom Action (e.g. Favorite / Star) -->
            <FrameLayout
                android:id="@+id/slotCustomActionRight"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Volume Control Row (Landscape) -->
        <LinearLayout
            android:id="@+id/layoutVolumeContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
            app:layout_constraintTop_toBottomOf="@id/transportControlsContainer">

            <ImageView
                android:id="@+id/imgVolumeDown"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_volume_down"
                app:tint="?attr/colorOnSurfaceVariant" />

            <SeekBar
                android:id="@+id/seekBarVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:progressTint="?attr/colorOnSurface"
                android:progressBackgroundTint="#33FFFFFF"
                android:thumbTint="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/imgVolumeUp"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_volume_up"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Auto-Open Countdown Progress and Notice (Landscape) -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressAutoOpen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="2dp"
            android:indeterminate="false"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/tvAutoOpenNotice"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
            tools:progress="60"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvAutoOpenNotice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/btnOpenApp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
            tools:text="Opening in 1s • Tap to stay"
            tools:visibility="visible" />

        <!-- Big Prominent Glassy Aquamorphic "Open in [App Name]" Button (Landscape) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenApp"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/open_app"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#2B808080"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_open_in_new"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
            app:rippleColor="#33FFFFFF"
            app:strokeColor="#47FFFFFF"
            app:strokeWidth="1.2dp"
            tools:text="Open in BitChord" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
